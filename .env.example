# Focus Realm Sales CRM — environment variables.
#
# Local development needs NONE of these: `npm run dev` uses an embedded
# Postgres in ./.data, demo calls, demo analysis and an email outbox folder.
# For production (Vercel or any server) set at least the REQUIRED block.
# Everything here is server-side only — never expose it to the browser.

# ------------------------------------------------------------------ REQUIRED

# Supabase Postgres. On Vercel use the POOLER connection string (port 6543):
# Supabase → Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL=

# Signs login sessions. 32+ random characters: openssl rand -hex 32
JWT_SECRET=

# Where people open the CRM (used in emails, login links and webhooks).
# On Vercel this defaults to your production domain if left empty.
APP_URL=https://crm.focusrealm.com

# Protects /api/cron/* (Vercel Cron sends it automatically as a Bearer token).
# openssl rand -hex 32
CRON_SECRET=

# ------------------------------------------------------- RECORDINGS (needed)

# Cloudflare R2: the main storage for call recordings (private bucket).
# Set up with docs/CLOUDFLARE_R2_PROMPT.md. Cloudflare → R2 Object Storage:
# the Account ID is on the overview page; the keys come from an API token
# with "Object Read & Write" on this bucket only. Server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crm-call-recordings
# Only for an EU-jurisdiction bucket: https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Alternative: a private Supabase Storage bucket (used only when the R2
# variables are empty; created automatically). Also needed, next to the R2
# variables, by `npm run copy-recordings-to-r2` to move older recordings.
# Supabase → Project Settings → API. Use the SERVICE ROLE key, server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECORDINGS_BUCKET=crm-call-recordings

# Force a storage driver instead of picking it from the above: r2 | supabase | local
# STORAGE_DRIVER=

# ---------------------------------------------------------- FIRST FOUNDER

# While the CRM has no founder, the sign-in page offers "Set up the CRM":
# the first founder enters this code, their FR number from Workspace and a
# password. Useless once a founder exists. openssl rand -hex 16
SETUP_CODE=

# ------------------------------------------------------ HR CONSOLE CONNECTION

# The same value as FOCUS_REALM_CRM_SECRET in the HR console.
# openssl rand -hex 32  — see docs/HR_CONSOLE_INTEGRATION.md
HR_WEBHOOK_SECRET=

# ---------------------------------------------------------- AI CALL ANALYSIS

# Who analyses calls and writes the daily reports: anthropic | gemini.
# Empty = whichever key below is set (Claude first). With neither, the CRM
# uses rule-based demo analysis (clearly labelled as such in the UI).
# Costs and the free option: README → "AI costs".
AI_PROVIDER=

# Claude (paid per use). claude-haiku-5-5 is ~40x cheaper than the default.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=high

# Google Gemini (free tier available: aistudio.google.com → Get API key).
# On the free tier Google may use and review what's sent (call recordings);
# enable billing on the Google project to avoid that. Also transcribes
# recordings when DEEPGRAM_API_KEY is empty (not AMR/3GP/WebM — use Deepgram for those).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Speech-to-text with speaker labels (handles Hindi–English calls).
# Optional with AI_PROVIDER=gemini.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# ------------------------------------------------------- ALERT EMAILS (optional)

# Daily reports are never emailed — they're in Daily Reports. With SMTP set,
# urgent alerts (handoffs, escalations, new tasks) are also emailed; without
# it they stay in-app only. Example: a SpaceMail mailbox.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Focus Realm CRM <crm@focusrealm.com>

# ---------------------------------------------------------------- TELEPHONY

# Only for "Bridge" calling (Settings → Calling): the provider rings the rep's
# phone, connects the prospect and records both sides. exotel | twilio
TELEPHONY_PROVIDER=
# Random value; protects the provider's callbacks. openssl rand -hex 24
TELEPHONY_WEBHOOK_TOKEN=

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
# Your ExoPhone (virtual number shown to prospects)
EXOTEL_CALLER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=

# ---------------------------------------------------------------- OPTIONAL

# Seed the demo sales floor on an empty database, and show one-tap demo logins.
# Defaults: on in development, off in production.
SEED_DEMO=false
DEMO_LOGINS=false

# Business timezone for "today", reports and reminders.
CRM_TIMEZONE=Asia/Kolkata

# Self-hosted only: run the minute-by-minute scheduler inside the server.
# (On Vercel this is off automatically; Vercel Cron and app traffic drive it.)
# IN_PROCESS_SCHEDULER=true
# PORT=4000
